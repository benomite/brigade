{
  "name": "brigade-restitution-des-essais",
  "version": "0.0.0",
  "private": true,
  "description": "One-time tool: gives back the tries lost to the dead-branch (refs/heads/v2) fetch failure (#4321)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "NODE_COMPILE_CACHE=\"${NODE_COMPILE_CACHE:-${TMPDIR:-/tmp}/brigade-runtime-compile-cache}\" node --test --test-force-exit --test-timeout=300000 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
