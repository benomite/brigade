{
  "name": "brigade-migration-etiquettes-anglais",
  "version": "0.0.0",
  "private": true,
  "description": "Brings an existing GitHub repo to the English label catalogue, and lists the French issue and PR text left",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "NODE_COMPILE_CACHE=\"${NODE_COMPILE_CACHE:-${TMPDIR:-/tmp}/brigade-runtime-compile-cache}\" node --test --test-force-exit --test-timeout=300000 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
