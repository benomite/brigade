{
  "name": "brigade-capture-ecran",
  "version": "0.0.0",
  "private": true,
  "description": "Capture un écran de l'app dans un PNG, en local : la vue rendue par un navigateur sans tête, devant des données figées — ni claude, ni box, ni réseau",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "NODE_COMPILE_CACHE=\"${NODE_COMPILE_CACHE:-${TMPDIR:-/tmp}/brigade-runtime-compile-cache}\" node --test --test-force-exit --test-timeout=300000 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
