{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"/.claude/brigade/gates-hook.sh",
            "asyncRewake": true,
            "timeout": 900,
            "statusMessage": "gates (arrière-plan)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"/.claude/brigade/gates-hook.sh",
            "asyncRewake": true,
            "timeout": 900,
            "statusMessage": "gates (arrière-plan)"
          }
        ]
      }
    ]
  }
}
