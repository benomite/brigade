# Réglages d'éditeur : propres à un poste, jamais au dépôt.
.vscode/
.idea/

# macOS
.DS_Store

# Résultats de `claude plugin eval` : artefacts de run, jamais des sources.
evals/results/

# État local du runtime, propre à chaque worktree (créé par worktree-setup.sh).
.brigade-state/

# Dépendances de dev du runtime.
node_modules/
