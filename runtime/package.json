{
  "name": "brigade-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime de brigade V2 : le process qui tient le journal d'un projet",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "GIT_CORE=\"$(git --exec-path 2>/dev/null)\"; PATH=\"${GIT_CORE:+$GIT_CORE:}$PATH\" NODE_COMPILE_CACHE=\"${NODE_COMPILE_CACHE:-${TMPDIR:-/tmp}/brigade-runtime-compile-cache}\" node --test --test-force-exit --test-timeout=120000 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "node src/main.ts",
    "journal": "node src/relire.ts",
    "rail": "node src/montrer-rail.ts",
    "status": "node src/status.ts",
    "mesures": "node src/montrer-mesures.ts",
    "garde-fous": "node src/garde-fous-cli.ts",
    "station": "node src/montrer-station.ts",
    "pass": "node src/montrer-pass.ts",
    "grant": "node src/grant-cli.ts",
    "base": "node src/base-cli.ts",
    "manager": "node src/manager-cli.ts",
    "sauvegarder": "node src/sauvegarder.ts",
    "restaurer": "node src/restaurer.ts",
    "installation": "node src/installation-cli.ts",
    "cloison": "node src/montrer-cloison.ts",
    "porte": "node src/tenir-porte.ts",
    "arbitre": "node src/arbitre-cli.ts",
    "tenir-arbitre": "node src/tenir-arbitre.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
