{
  "name": "brigade-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime de brigade V2 : le process qui tient le journal d'un projet",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "GIT_CORE=\"$(git --exec-path 2>/dev/null)\"; PATH=\"${GIT_CORE:+$GIT_CORE:}$PATH\" NODE_COMPILE_CACHE=\"${NODE_COMPILE_CACHE:-${TMPDIR:-/tmp}/brigade-runtime-compile-cache}\" node --import ./test-hang-guard/charger.ts --test --test-concurrency=5 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/garde-duree/reporteur.ts --test-reporter-destination=stderr --test-force-exit --test-timeout=120000 \"test/**/*.test.ts\" \"test-hang-guard/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "node src/main.ts",
    "status": "node src/status.ts",
    "facts": "node src/faits.ts",
    "rail": "node src/montrer-rail.ts",
    "release-notes": "node src/release-notes-cli.ts",
    "log": "node src/relire.ts",
    "station": "node src/montrer-station.ts",
    "setting": "node src/reglage-cli.ts",
    "humans": "node src/humains-cli.ts",
    "recurring": "node src/recurrents-cli.ts",
    "explanations": "node src/explications-cli.ts",
    "contributor-stations": "node src/contributor-stations-cli.ts",
    "switch": "node src/interrupteur-cli.ts",
    "manager": "node src/manager-cli.ts",
    "waiting": "node src/attente-cli.ts",
    "design": "node src/design-cli.ts",
    "sensitive": "node src/sensitive-cli.ts",
    "undo": "node src/undo-cli.ts",
    "report": "node src/rapport-cli.ts",
    "guardrails": "node src/garde-fous-cli.ts",
    "base": "node src/base-cli.ts",
    "installation": "node src/installation-cli.ts",
    "measures": "node src/montrer-mesures.ts",
    "closing": "node src/fermeture.ts",
    "backup": "node src/sauvegarder.ts",
    "restore": "node src/restaurer.ts",
    "partition": "node src/montrer-cloison.ts",
    "arbiter": "node src/arbitre-cli.ts",
    "door": "node src/tenir-porte.ts",
    "hold-arbiter": "node src/tenir-arbitre.ts",
    "help": "node src/aide.ts",
    "faits": "node src/ancien-nom.ts",
    "journal": "node src/ancien-nom.ts",
    "garde-fous": "node src/ancien-nom.ts",
    "attente": "node src/ancien-nom.ts",
    "mesures": "node src/ancien-nom.ts",
    "fermeture": "node src/ancien-nom.ts",
    "sauvegarder": "node src/ancien-nom.ts",
    "restaurer": "node src/ancien-nom.ts",
    "cloison": "node src/ancien-nom.ts",
    "arbitre": "node src/ancien-nom.ts",
    "porte": "node src/ancien-nom.ts",
    "tenir-arbitre": "node src/ancien-nom.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
