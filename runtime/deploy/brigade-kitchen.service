[Unit]
Description=brigade — the new kitchen (scheduler; agents in their prompts)
After=network-online.target brigade-station-porte.service
Wants=network-online.target brigade-station-porte.service

[Service]
Type=simple
User=brigade
WorkingDirectory=/usr/lib/brigade-station/runtime
ExecStart=/usr/lib/brigade-station/node/bin/node src/kitchen/main.ts
Environment=BRIGADE_STATION_DIR=/var/lib/brigade
Environment=BRIGADE_SANDBOX_BIN=/usr/bin/bwrap
Environment=BRIGADE_SANDBOX_HIDDEN=/var/lib/brigade:/etc/brigade
Environment=BRIGADE_STATION_PORTES=/var/lib/brigade/portes.json
EnvironmentFile=-/etc/brigade/jeton.env
IPAddressDeny=any
IPAddressAllow=localhost
Restart=always
RestartSec=10
# The agents run under their relays: a restart of the kitchen leaves them running.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
