#!/bin/bash
# Le geste d'une station : lance une commande du runtime pour un de ses projets.
#
#   brigade <projet> <commande> [arguments…]
#   brigade <projet> help         les commandes du runtime, sous leur nom anglais
#   brigade --help
#
# C'est par lui que l'app lit et pilote, par `ssh`, les projets d'une machine
# qui les servait avant la station (docs/bascule.md). Une commande se tape sous
# son nom anglais (docs/glossary.md) ; son ancien nom français est accepté, mais
# ni l'aide ni le refus d'une commande inconnue ne le nomment.
#
# Le paquet de la station le porte (/usr/lib/brigade-station/brigade), à côté
# du runtime et du `node` qu'il lance ; la bascule y pointe /usr/local/bin/brigade,
# que nomme la règle sudoers du geste. Rien de la machine n'y est écrit : le
# compte et l'environnement se lisent dans l'unité de la station, le projet
# dans sa configuration — la commande tourne avec ce que la station donne au
# projet, pas avec une variable recopiée (runtime/src/station/geste.ts).
#
# Codes de sortie : celui de la commande, sauf
#   64  il manque le projet ou la commande
#   65  projet inconnu sur cette station
#   66  la commande n'est pas une commande du runtime
#   67  systemd n'a pas répondu pour l'unité de la station
#   68  celui qui lance n'a pas le droit du geste sur cette machine
#   69  `sudo` manque sur cette machine
set -u

USAGE=64
PROJET_INCONNU=65
SYSTEMD_MUET=67
SANS_DROIT=68
SUDO_ABSENT=69
DOC="docs/bascule.md, « Le geste brigade »"
# Le `PATH` qu'une unité reçoit quand elle n'en pose pas.
PATH_DE_SYSTEMD=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
UNITE=brigade-station.service

usage() {
  echo "usage: brigade <project> <command> [arguments…]"
  echo "       brigade <project> help    lists the commands"
}
case "${1:-}" in
  -h | --help) usage; exit 0 ;;
esac
if [ $# -lt 2 ]; then
  usage >&2
  exit $USAGE
fi
projet="$1"
commande="$2"
case "$commande" in
  -h | --help) commande=help ;;
esac

# Pose dans `lu` une propriété de l'unité. Appelée telle quelle, jamais dans
# `$(…)` : son refus doit arrêter le geste, pas un sous-shell.
de_l_unite() {
  lu="$(systemctl show -p "$1" --value "$UNITE")" || {
    echo "brigade : systemd n'a pas répondu pour $UNITE (\`systemctl show -p $1\` rend $?)" >&2
    exit $SYSTEMD_MUET
  }
}

# Un nom qui n'est pas un nom de projet ne va pas plus loin. Le projet se
# cherche dans la configuration de la station, que seul son compte lit.
case "$projet" in
  "" | *[!a-z0-9-]*)
    echo "brigade : projet inconnu sur cette station — « $projet » n'est pas un nom de projet" >&2
    exit $PROJET_INCONNU
    ;;
esac

de_l_unite User
compte="${lu:-root}"
qui="$(id -un)"
if [ "$qui" != "$compte" ]; then
  command -v sudo >/dev/null || {
    echo "brigade : \`sudo\` manque sur cette machine — le geste passe par lui sous le compte « $compte » ($DOC)" >&2
    exit $SUDO_ABSENT
  }
  # `sudo` demande son mot de passe sur le terminal, pas sur l'entrée. Sans
  # terminal — par `ssh` —, il ne peut rien demander, et son refus sortirait en
  # 1, comme une commande du runtime qui échoue. Le geste s'y lance donc d'abord
  # à vide : seul celui que `sudo` laisse passer sans mot de passe en reçoit
  # l'usage, et tout autre code est un refus, quelle qu'en soit la raison.
  if ! (: </dev/tty) 2>/dev/null; then
    sudo -n -u "$compte" -- "$0" >/dev/null 2>&1
    if [ $? != $USAGE ]; then
      echo "brigade : « $qui » n'a pas le droit de lancer le geste sur cette machine — sans terminal, \`sudo\` ne le lui donne pas sous le compte « $compte » sans mot de passe ($DOC)" >&2
      exit $SANS_DROIT
    fi
  fi
  # La règle sudoers nomme ce fichier, rien d'autre. `sudo` passe les
  # arguments un à un : aucun shell ne les redécoupe.
  exec sudo -H -u "$compte" -- "$0" "$@"
fi
shift 2
[ "${1:-}" = "--" ] && shift

# Ce que systemd donne d'office à un service, puis ce que l'unité déclare.
environnement=("PATH=$PATH_DE_SYSTEMD" "HOME=$HOME" "USER=$compte" "LOGNAME=$compte" ${LANG:+"LANG=$LANG"} ${TERM:+"TERM=$TERM"})
# `systemctl show` sépare les affectations par des espaces, et met entre
# guillemets doubles, `\` devant ce qui s'échappe, celles qui en contiennent.
# Lu caractère par caractère : rien de l'unité n'est évalué par ce shell.
de_l_unite Environment
brut="$lu"
mot="" ouvert=0 cite=0 i=0
while [ $i -lt ${#brut} ]; do
  c="${brut:$i:1}"
  i=$((i + 1))
  if [ "$c" = "\\" ] && [ $i -lt ${#brut} ]; then
    mot+="${brut:$i:1}"
    i=$((i + 1))
    ouvert=1
  elif [ "$c" = '"' ]; then
    cite=$((1 - cite))
    ouvert=1
  elif [ $cite = 0 ] && { [ "$c" = " " ] || [ "$c" = $'\n' ]; }; then
    [ $ouvert = 1 ] && environnement+=("$mot")
    mot="" ouvert=0
  else
    mot+="$c"
    ouvert=1
  fi
done
[ $ouvert = 1 ] && environnement+=("$mot")

# Le projet, sa ligne et la commande se jugent dans le runtime, sous le compte
# de la station : il dit le refus, ou lance la commande avec l'environnement
# du projet. Le répertoire de celui qui lance n'est pas forcément lisible du
# compte : la commande part de celui du runtime.
# Ce que le paquet pose à côté de ce fichier : le runtime, et son `node`.
ici="$(dirname "$(readlink -f "$0")")"
cd "$ici/runtime" || exit
exec env -i "${environnement[@]}" "$ici/node/bin/node" src/station/geste.ts "$projet" "$commande" "$@"
