# Runtime de brigade, une instance par projet : brigade@<projet>.service
# Installation : docs/installer.md ; ce qu'il fait une fois lancé : docs/runtime/README.md
#
# Ce fichier se copie tel quel. Ce qui dépend de la machine (compte, chemin de
# node, emplacement du clone, ports) se règle dans un drop-in, jamais ici. Ce
# que le chef décide (stations, seuils de coût, calibrage du manager et du
# reviewer) n'y a plus sa place : le runtime ne le lit que du journal du projet,
# par `brigade <projet> station <geste> <valeur>`.

[Unit]
Description=brigade — runtime du projet %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Le compte Unix qui a fait la connexion Max : `claude` y trouve ses
# identifiants là où il les attend, sans qu'on les copie.
User=brigade
WorkingDirectory=/opt/brigade/runtime
ExecStart=/usr/bin/env node src/main.ts

# Tout l'état du projet vit dans un seul répertoire, créé par systemd au bon
# propriétaire. Il doit être sur un disque local : le verrou en dépend.
StateDirectory=brigade/%i
Environment=BRIGADE_STATE_DIR=/var/lib/brigade/%i
Environment=BRIGADE_PROJECT=%i
# Le clone du dépôt du projet, réservé à la station : elle y accroche le
# worktree de chaque cook et n'en modifie jamais l'arbre. À cloner une fois,
# sous le compte du service (docs/installer.md, « Déclarer le projet »).
Environment=BRIGADE_REPO_DIR=/var/lib/brigade/%i/depot
# Le dépôt GitHub du projet (BRIGADE_GITHUB_REPO=<owner>/<repo>) et sa branche
# d'intégration (BRIGADE_BASE_BRANCH) ne se déduisent pas du nom de l'instance :
# ils se posent dans un drop-in de l'instance,
# `systemctl edit brigade@<projet>.service`. Sans eux, le runtime refuse de
# démarrer.
#
# BRIGADE_ROADMAP_ISSUE, facultative, y désigne l'issue de roadmap que le
# manager ne doit jamais juger. Le calibrage du manager et du reviewer, et le
# plafond de la montée de calibrage d'un ticket qui échoue en pass (`opus` /
# `high` par défaut), sont des décisions du chef : ils se posent par le geste
# `station`, pas ici.
#
# BRIGADE_GITHUB_APPS_DIR, facultative, désigne le répertoire des trois GitHub
# Apps du projet (cook, pass, manager : un identifiant et une clé privée par
# rôle, lisibles du seul compte du service). Sans elle, tout ce que le runtime
# fait sur GitHub part sous le compte de la machine, et rien ne réserve le
# merge à la pass. Même drop-in ; les clés, elles, ne s'y écrivent jamais.
#
# `claude` est lancé par son nom, dans le PATH de cette unité — celui de
# systemd (/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin), pas celui d'un
# shell. L'installeur natif le pose sous ~/.local/bin du compte : sans un lien
# vers lui dans /usr/local/bin, aucun cook ne part. La commande `installation`
# le vérifie, dans le PATH que l'unité donnera (docs/installer.md, « Préparer
# la box »).
#
# Rien ici ne cloisonne ce que le runtime lance, ni ne filtre son réseau : la
# cloison se pose projet par projet, par un drop-in (`cloison.conf`) et la
# porte du projet (`brigade-porte@.service`) — docs/runtime/cloison-et-arbitre.md, « La cloison ».
# Sans elle, les projets servis sous ce compte se voient, et le runtime le dit
# à chaque démarrage.
#
# Rien ici ne donne à `claude` une clé ni un jeton, et rien ne doit le faire :
# le runtime refuse de démarrer s'il en trouve un dans son environnement. Les
# cooks passent par la connexion Max du compte, faite dans le binaire officiel.

# Un /tmp à l'unité, vidé à son arrêt. `claude` range ses fichiers temporaires
# dans /tmp/claude-<uid du compte> et refuse ce répertoire s'il existe sans
# être au compte : dans le /tmp de la machine, n'importe qui peut l'y avoir
# posé, et chaque cook échouerait. Dans celui-ci, il n'y a que les siens.
PrivateTmp=yes

# Un crash relance le runtime ; un refus de démarrer (code 2 : configuration
# invalide, ou un autre runtime tient déjà le projet) ne se réessaie pas.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

# `systemctl stop` envoie SIGTERM au seul process du runtime : il journalise
# son arrêt et sort. Les cooks, que chacun un relais détaché porte, ne reçoivent
# rien — c'est ce qui les laisse finir pendant une mise à jour, et le runtime
# suivant les reprend (`relais.ts`). `control-group` enverrait SIGTERM à tout le
# cgroup, relais et cooks compris : trois cooks sortis en code 143 (#704). Le
# « stop » du chef arrête les cooks par le runtime (`guardrails -- stop`),
# jamais par l'unité.
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
