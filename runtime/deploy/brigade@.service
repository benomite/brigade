# Runtime de brigade, une instance par projet : brigade@<projet>.service
# Installation et recette : docs/runtime.md
#
# Ce fichier se copie tel quel. Ce qui dépend de la machine (compte, chemin de
# node, emplacement du clone) se règle dans un drop-in, jamais ici.

[Unit]
Description=brigade — runtime du projet %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Le compte Unix qui a fait la connexion Max : `claude` y trouve ses
# identifiants là où il les attend, sans qu'on les copie.
User=brigade
WorkingDirectory=/opt/brigade/runtime
ExecStart=/usr/bin/env node src/main.ts

# Tout l'état du projet vit dans un seul répertoire, créé par systemd au bon
# propriétaire. Il doit être sur un disque local : le verrou en dépend.
StateDirectory=brigade/%i
Environment=BRIGADE_STATE_DIR=/var/lib/brigade/%i
Environment=BRIGADE_PROJECT=%i
# Le clone du dépôt du projet, réservé à la station : elle y accroche le
# worktree de chaque cook et n'en modifie jamais l'arbre. À cloner une fois,
# sous le compte du service (docs/runtime.md).
Environment=BRIGADE_REPO_DIR=/var/lib/brigade/%i/depot
# Le dépôt GitHub du projet (BRIGADE_GITHUB_REPO=<owner>/<repo>) et sa branche
# d'intégration (BRIGADE_BASE_BRANCH) ne se déduisent pas du nom de l'instance :
# ils se posent dans un drop-in de l'instance,
# `systemctl edit brigade@<projet>.service`. Sans eux, le runtime refuse de
# démarrer.
#
# Rien ici ne donne à `claude` une clé ni un jeton, et rien ne doit le faire :
# le runtime refuse de démarrer s'il en trouve un dans son environnement. Les
# cooks passent par la connexion Max du compte, faite dans le binaire officiel.

# Un crash relance le runtime ; un refus de démarrer (code 2 : configuration
# invalide, ou un autre runtime tient déjà le projet) ne se réessaie pas.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

# `systemctl stop` envoie SIGTERM : le runtime journalise son arrêt et sort.
# Tout le cgroup est arrêté avec lui — c'est le « stop » de dernier recours.
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
