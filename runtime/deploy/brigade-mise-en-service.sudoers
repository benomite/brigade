# La règle du geste de mise en service de la box :
# /etc/sudoers.d/brigade-mise-en-service. Elle ne nomme que lui. Le groupe est
# celui du geste `brigade` ; sa règle (/etc/sudoers.d/brigade) et celle du geste
# d'installation (/etc/sudoers.d/brigade-installer) ne changent pas.
#
#   sudo install -m 440 /opt/brigade/runtime/deploy/brigade-mise-en-service.sudoers /etc/sudoers.d/brigade-mise-en-service
#   sudo visudo -cf /etc/sudoers.d/brigade-mise-en-service
#
# Sans mot de passe : le geste se lance par `ssh`, sans terminal où en taper un.
# Sans `SETENV` : celui qui lance ne choisit aucune variable de son
# environnement — et le geste n'en lit aucune.
# Sans argument écrit ici, donc sans joker : c'est le geste qui refuse tout ce
# qui n'est pas, seul, le nom d'un projet déclaré sur la box.
%brigade-chefs ALL=(root) NOPASSWD: /usr/local/bin/brigade-mise-en-service
