# La règle du geste d'installation de la box : /etc/sudoers.d/brigade-installer.
# Elle ne nomme que lui. Le groupe est celui du geste `brigade`, dont la règle
# (/etc/sudoers.d/brigade) ne change pas.
#
#   sudo install -m 440 /opt/brigade/runtime/deploy/brigade-installer.sudoers /etc/sudoers.d/brigade-installer
#   sudo visudo -cf /etc/sudoers.d/brigade-installer
#
# Sans mot de passe : l'app le lance par `ssh`, sans terminal où en taper un.
# Sans `SETENV` : celui qui lance ne choisit aucune variable de son
# environnement — et le geste n'en lit aucune, sinon le nom que `sudo` lui
# donne de l'appelant.
%brigade-chefs ALL=(root) NOPASSWD: /usr/local/bin/brigade-installer
