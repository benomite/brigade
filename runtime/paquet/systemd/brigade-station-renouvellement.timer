# Joue brigade-station-renouvellement.service toutes les trente secondes.
#
# `claude` ne rafraîchit son jeton qu'à moins de cinq minutes de l'échéance :
# plus ce passage vient tôt dans la fenêtre, moins un cook l'y précède. Et
# c'est ce passage qui consigne un login : la station le voit au suivant, et
# la cuisine reprend dans la minute. Un passage sans rien à renouveler ne
# coûte rien au quota.
#
# Livré par le paquet brigade-station, et remplacé à chacune de ses mises à
# jour : ne pas l'éditer.

[Unit]
Description=brigade — renouvellement de la session Max, toutes les trente secondes

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
