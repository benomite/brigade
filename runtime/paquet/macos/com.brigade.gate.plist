<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.brigade.gate</string>
  <!-- root: the one account the pf anchor `brigade` does not block, so the only way out. -->
  <key>UserName</key><string>root</string>
  <key>ProgramArguments</key><array>
    <string>/opt/brigade-station/current/node/bin/node</string>
    <string>/opt/brigade-station/current/runtime/src/station/tenir-portes.ts</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>BRIGADE_STATION_DIR</key><string>/Library/Application Support/brigade</string>
    <key>BRIGADE_STATION_PORTES</key><string>/Library/Application Support/brigade/portes.json</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
