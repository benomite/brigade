#!/bin/sh
# Le pont (#4741) : ce paquet n'est plus la station, il la fait passer à l'archive.
# Ce que dpkg joue après avoir posé ses fichiers — l'archive linux-x64 du paquet — tient
# en une chose : défaire l'archive et jouer son `install.sh --migrate`, qui pose
# /opt/brigade-station/<version>, garde /var/lib/brigade et /etc/brigade tels quels, retire
# les unités et l'arbre /usr/lib de l'ancien paquet, et installe et démarre les unités de
# l'archive. Puis le paquet est retiré de la base de dpkg, sans toucher à ce qui est sous
# /opt : le sens est unique, la station se met à jour seule par l'archive ensuite.
#
# Rejoué (le paquet réinstallé, une seconde configuration), il ne change rien : l'install.sh
# garde la version que `current` désigne, et le retrait d'un paquet déjà parti se tait.
#
# Le paquet n'a ni prerm ni postrm : son retrait ne doit jamais arrêter la station, qui
# n'est plus à lui.
#
# BRIGADE_RACINE=<dossier> préfixe les chemins que ce script lit (les tests).
set -e

RACINE="${BRIGADE_RACINE:-}"
PAQUET=brigade-station
ARCHIVE="$RACINE/usr/share/$PAQUET/$PAQUET-linux-x64.tar.gz"

# Retire le paquet de la base de dpkg une fois que dpkg a fini (il tient son verrou tant
# que ce script tourne : l'appeler d'ici échouerait). `--purge`, pour qu'il ne reste « rc » nulle part.
# Détaché : le postinst n'attend pas.
RETRAIT='
essais=0
while [ "$essais" -lt 120 ]; do
  dpkg --purge brigade-station >/dev/null 2>&1 && exit 0
  etat=$(dpkg-query -W -f="\${db:Status-Status}" brigade-station 2>/dev/null) || exit 0
  [ "$etat" != not-installed ] || exit 0
  essais=$((essais + 1))
  sleep 5
done
exit 1
'

case "$1" in
  configure)
    # Sans systemd en marche (un chroot, un conteneur), il n'y a pas de station à passer.
    if [ -z "$RACINE" ] && [ ! -d /run/systemd/system ]; then
      echo "brigade-station : systemd ne tourne pas ici, la station n'est pas migrée vers l'archive" >&2
      exit 0
    fi
    [ -f "$ARCHIVE" ] || { echo "brigade-station : l'archive du paquet manque ($ARCHIVE)" >&2; exit 1; }
    travail=$(mktemp -d)
    trap 'rm -rf "$travail"' EXIT
    tar -xzf "$ARCHIVE" -C "$travail"
    sh "$travail/install.sh" --migrate

    if [ -z "$RACINE" ] && [ -d /run/systemd/system ] && command -v systemd-run >/dev/null 2>&1; then
      systemd-run --quiet --collect --unit=brigade-station-pont-retrait sh -c "$RETRAIT" || true
    else
      setsid --fork sh -c "$RETRAIT" >/dev/null 2>&1 </dev/null || true
    fi
    ;;
esac

exit 0
