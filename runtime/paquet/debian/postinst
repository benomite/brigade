#!/bin/sh
# Ce que dpkg joue après avoir posé les fichiers du paquet, à l'installation
# comme à chaque mise à jour : c'est ici, et nulle part ailleurs, que la
# station prend ce que le système lui doit. Aucune règle sudoers : la vie
# courante de la station ne passe jamais par root.
set -e

COMPTE=brigade
UNITES="brigade-station.service"
# Les portes de la station : pas activées pour elles-mêmes, la station les
# réclame.
PORTES=brigade-station-porte.service
# Les unités de l'ancien runtime, posées à la main ou par une version
# précédente du paquet : la station fait tourner la cuisine seule (deux cuisines
# ne servent jamais les mêmes projets), les cooks lisent /etc/brigade/jeton.env
# (plus de renouvellement), et l'état de l'ancien runtime n'est plus à
# sauvegarder. Les modèles à instances (brigade-sauvegarde@<projet>) sont
# retrouvés par leurs liens d'activation et leurs drop-ins.
ANCIENNES="brigade-kitchen.service brigade-arbitre.service brigade-renouvellement.service brigade-renouvellement.timer brigade-station-renouvellement.service brigade-station-renouvellement.timer brigade-sauvegarde@.service brigade-sauvegarde@.timer"
UNITES_A_LA_MAIN=/etc/systemd/system

# Arrête, désactive et supprime chaque unité de l'ancien runtime que la machine
# porte encore, avec ses drop-ins ; ce que la machine n'a pas n'est pas touché.
retirer_anciennes() {
  liste="$ANCIENNES"
  for lien in "$UNITES_A_LA_MAIN"/*.wants/brigade-sauvegarde@*.timer "$UNITES_A_LA_MAIN"/*.wants/brigade-sauvegarde@*.service \
      "$UNITES_A_LA_MAIN"/brigade-sauvegarde@*.service.d "$UNITES_A_LA_MAIN"/brigade-sauvegarde@*.timer.d; do
    [ -e "$lien" ] || [ -L "$lien" ] || continue
    nom=${lien##*/}
    liste="$liste ${nom%.d}"
  done
  for unite in $liste; do
    presente=
    for chemin in "$UNITES_A_LA_MAIN/$unite" "$UNITES_A_LA_MAIN/$unite.d" "$UNITES_A_LA_MAIN"/*.wants/"$unite"; do
      if [ -e "$chemin" ] || [ -L "$chemin" ]; then presente=oui; fi
    done
    [ -n "$presente" ] || continue
    case "$unite" in *@.*) ;; *) systemctl disable --now "$unite" || true ;; esac
    rm -rf "$UNITES_A_LA_MAIN/$unite" "$UNITES_A_LA_MAIN/$unite.d" "$UNITES_A_LA_MAIN"/*.wants/"$unite"
  done
}

case "$1" in
  configure)
    # Le compte du service, celui qui fera la connexion Max. Déjà là — une
    # machine qui servait brigade avant le paquet —, il est gardé tel quel.
    if ! getent passwd "$COMPTE" >/dev/null; then
      if getent group "$COMPTE" >/dev/null; then
        adduser --quiet --system --ingroup "$COMPTE" --home "/home/$COMPTE" --shell /bin/bash "$COMPTE"
      else
        adduser --quiet --system --group --home "/home/$COMPTE" --shell /bin/bash "$COMPTE"
      fi
    fi

    # Sans systemd en marche (un chroot, un conteneur), rien à démarrer.
    if [ -d /run/systemd/system ]; then
      # Their agents in flight keep running under their relays (KillMode=process):
      # the station's kitchen takes them back.
      retirer_anciennes
      systemctl daemon-reload
      if [ -z "${2:-}" ]; then
        # Première installation : la station démarre, et redémarrera avec la
        # machine.
        systemctl enable --now $UNITES
      else
        # Une mise à jour : ce qui est activé repart sur le nouveau code — les
        # agents en cours, eux, finissent (KillMode=process). Ce que
        # l'administrateur a désactivé le reste. Les portes d'abord, si elles
        # tournent : chacune reprend son port, et la station la retrouve ; une
        # station qui ne les connaissait pas les démarre en repartant (Wants=).
        if systemctl --quiet is-active "$PORTES"; then
          systemctl restart "$PORTES"
        fi
        for unite in $UNITES; do
          if systemctl --quiet is-enabled "$unite"; then
            systemctl restart "$unite"
          fi
        done
      fi
    fi
    ;;
esac

exit 0
