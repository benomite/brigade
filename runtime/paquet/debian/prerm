#!/bin/sh
# Ce que dpkg joue avant de retirer les fichiers du paquet. Une mise à jour ne
# passe pas par ici : c'est postinst qui relance la station sur le nouveau
# code, sans l'arrêter avant.
set -e

case "$1" in
  remove)
    # La station s'arrête, puis ses portes ; ses cooks en cours finissent
    # (KillMode=process), sans réseau. Rien de son état n'est touché :
    # /var/lib/brigade reste.
    if [ -d /run/systemd/system ]; then
      systemctl stop brigade-station.service brigade-station-renouvellement.timer brigade-station-porte.service || true
    fi
    ;;
esac

exit 0
